{
  "name": "adika-pdf-editor",
  "private": true,
  "version": "1.9.0",
  "description": "Adika PDF Editor - privacy-first, offline PDF editor with e-signatures",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "assets": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "build": "npm run assets && tsc -b && vite build",
    "build:thumbs": "cargo build --release --offline --manifest-path src-tauri/thumbs/Cargo.toml",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:e2e": "node tests/e2e/suite.mjs",
    "test:e2e:installed": "node tests/e2e/open-with.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-mono": "^0.4.2",
    "@expo-google-fonts/noto-serif": "^0.4.2",
    "@kenjiuno/decompressrtf": "^0.1.4",
    "@kenjiuno/msgreader": "^1.28.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/hun": "^1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "@tesseract.js-data/pol": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/ron": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.2",
    "dxf-parser": "^1.1.2",
    "jszip": "^3.10.2",
    "konva": "^10.7.0",
    "libheif-js": "^1.23.2",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "postal-mime": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "utif": "^3.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/utif": "^3.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.0.0"
  }
}
