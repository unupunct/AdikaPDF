{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: file dialogs only; file I/O goes through the app's own commands.",
  "windows": ["main"],
  "permissions": ["core:default", "dialog:allow-open", "dialog:allow-save", "dialog:allow-message", "dialog:allow-ask", "opener:allow-open-url", "core:window:allow-set-fullscreen", "core:window:allow-is-fullscreen", "core:window:allow-destroy"]
}
