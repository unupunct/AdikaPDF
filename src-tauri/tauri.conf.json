{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adika PDF Editor",
  "version": "1.10.0",
  "identifier": "eu.unupunct.adikapdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && npm run build:thumbs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Adika PDF Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost blob: data:; script-src 'self' blob: 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data: https:; frame-src 'self' blob:; object-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "windows/printer.ps1": "printer.ps1", "thumbs/target/release/adika_thumbs.dll": "adika_thumbs.dll" },
    "publisher": "unupunct",
    "copyright": "Copyright (c) 2026 unupunct. MIT License.",
    "category": "Productivity",
    "shortDescription": "Privacy-first offline PDF editor with e-signatures",
    "longDescription": "Adika PDF Editor edits, signs, organises, protects, OCRs and converts PDF files entirely on your computer. No uploads.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "Adika PDF Document", "description": "PDF document", "role": "Editor", "mimeType": "application/pdf" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "signCommand": { "cmd": "node", "args": ["../scripts/sign.mjs", "%1"] },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCRUIzRUY5RUZGMDkwMkYKUldRdmtQRHYrVDdybXpkWmo4UG1EWDhlcXpSM1Q4dEc0Ty95T0xEM1V0MWoyM2oxbGhuSkJyQmUK",
      "endpoints": ["https://github.com/unupunct/AdikaPDF/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
